{
    "schema_version": 2,
    "name": "{{ cookiecutter.__project_slug }}",
    "description": "{{ cookiecutter.description }}",
    "release": {
        "substrate": "fargate",
        "shape": {
            "vcpu": 0.5,
            "memory_mib": 1024,
            "storage_gib": 21
        },
        "grants": ["*:read"],
        {%- if cookiecutter.input_data_type == "topics" %}
        "requires_downloaded_inputs": false,
        {%- endif %}
        "parameters": []
    }
}
